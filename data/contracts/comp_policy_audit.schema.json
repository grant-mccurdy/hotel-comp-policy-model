    "recommended_comp_value",
    "recommended_minus_actual_value",
    "internal_cost_delta",
    "recommended_internal_cost_low",
    "recommended_internal_cost_high",
    "decision_confidence",
    "recommendation_stability",
    "policy_id",
    "policy_version"
  ],
  "allowed_audit_classes": [
    "aligned_recovery",
    "under_recovered",
    "over_comped",
    "manager_review_required",
    "data_quality_hold"
  ],
  "stage3_rule": "Audit classes are synthetic policy diagnostics, not observed judgments about any real hotel operator."
}
