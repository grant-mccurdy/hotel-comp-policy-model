{
  "contract_name": "source_booking_stays",
  "version": "stage1-v1",
  "source": "Hotel Booking Demand / TidyTuesday hotels.csv",
  "description": "Observed public PMS-style booking and stay context used for calibration.",
  "primary_key": null,
  "row_grain": "one hotel booking",
  "provenance_default": "observed_public",
  "required_fields": [
    "hotel",
    "lead_time",
    "stays_in_weekend_nights",
    "stays_in_week_nights",
    "is_repeated_guest",
    "reserved_room_type",
    "assigned_room_type",
    "days_in_waiting_list",
    "customer_type",
    "adr",
    "total_of_special_requests"
  ],
  "fields": [
    {"name": "hotel", "type": "string", "provenance": "observed_public", "use": "hotel type context"},
    {"name": "is_canceled", "type": "integer", "provenance": "observed_public", "use": "booking outcome context"},
    {"name": "lead_time", "type": "integer", "provenance": "observed_public", "use": "booking planning horizon"},
    {"name": "arrival_date_year", "type": "integer", "provenance": "observed_public", "use": "seasonality"},
    {"name": "arrival_date_month", "type": "string", "provenance": "observed_public", "use": "seasonality"},
    {"name": "arrival_date_week_number", "type": "integer", "provenance": "observed_public", "use": "seasonality"},
    {"name": "arrival_date_day_of_month", "type": "integer", "provenance": "observed_public", "use": "seasonality"},
    {"name": "stays_in_weekend_nights", "type": "integer", "provenance": "observed_public", "use": "stay length"},
    {"name": "stays_in_week_nights", "type": "integer", "provenance": "observed_public", "use": "stay length"},
    {"name": "adults", "type": "integer", "provenance": "observed_public", "use": "party size"},
    {"name": "children", "type": "number", "provenance": "observed_public", "use": "party size"},
    {"name": "babies", "type": "integer", "provenance": "observed_public", "use": "party size"},
    {"name": "meal", "type": "string", "provenance": "observed_public", "use": "booking package context"},
    {"name": "country", "type": "string", "provenance": "observed_public", "use": "market context only"},
    {"name": "market_segment", "type": "string", "provenance": "observed_public", "use": "booking channel context"},
    {"name": "distribution_channel", "type": "string", "provenance": "observed_public", "use": "booking channel context"},
    {"name": "is_repeated_guest", "type": "integer", "provenance": "observed_public", "use": "loyalty proxy"},
    {"name": "previous_cancellations", "type": "integer", "provenance": "observed_public", "use": "guest history proxy"},
    {"name": "previous_bookings_not_canceled", "type": "integer", "provenance": "observed_public", "use": "guest history proxy"},
    {"name": "reserved_room_type", "type": "string", "provenance": "observed_public", "use": "room expectation"},
    {"name": "assigned_room_type", "type": "string", "provenance": "observed_public", "use": "room outcome"},
    {"name": "booking_changes", "type": "integer", "provenance": "observed_public", "use": "friction proxy"},
    {"name": "deposit_type", "type": "string", "provenance": "observed_public", "use": "booking commitment context"},
    {"name": "agent", "type": "string", "provenance": "observed_public", "use": "channel metadata"},
    {"name": "company", "type": "string", "provenance": "observed_public", "use": "channel metadata"},
    {"name": "days_in_waiting_list", "type": "integer", "provenance": "observed_public", "use": "wait/friction proxy"},
    {"name": "customer_type", "type": "string", "provenance": "observed_public", "use": "guest segment"},
    {"name": "adr", "type": "number", "provenance": "observed_public", "use": "daily rate / guest value proxy"},
    {"name": "required_car_parking_spaces", "type": "integer", "provenance": "observed_public", "use": "guest need proxy"},
    {"name": "total_of_special_requests", "type": "integer", "provenance": "observed_public", "use": "guest need proxy"},
    {"name": "reservation_status", "type": "string", "provenance": "observed_public", "use": "booking outcome"},
    {"name": "reservation_status_date", "type": "date", "provenance": "observed_public", "use": "booking outcome timing"},
    {"name": "room_type_mismatch", "type": "boolean", "provenance": "derived_public", "use": "derived service-friction proxy"}
  ]
}
